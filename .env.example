# =============================================================================
# ⚙️ CẤU HÌNH MULTI-PROVIDER LLM ADAPTER
# =============================================================================

# -----------------------------------------------------------------------------
# 📌 BƯỚC 1: CHỌN NHÀ CUNG CẤP AI (LLM_PROVIDER)
# Chọn 1 trong các giá trị sau: gemini | openai | anthropic | openrouter | mock
# -----------------------------------------------------------------------------
LLM_PROVIDER=gemini

# -----------------------------------------------------------------------------
# 📌 BƯỚC 2: ĐIỀN API KEY CHO PROVIDER ĐÃ CHỌN Ở BƯỚC 1
# -----------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# -----------------------------------------------------------------------------
# 📌 BƯỚC 3: (TÙY CHỌN) GHI ĐÈ TÊN MODEL CỤ THỂ (LLM_MODEL)
#
# 💡 Mặc định nếu ĐỂ TRỐNG (LLM_MODEL=), hệ thống tự dùng Model chuẩn của Provider:
#   - Nếu chọn LLM_PROVIDER=gemini     ➔ Mặc định dùng: gemini-2.5-flash
#   - Nếu chọn LLM_PROVIDER=openai     ➔ Mặc định dùng: gpt-4o-mini
#   - Nếu chọn LLM_PROVIDER=anthropic  ➔ Mặc định dùng: claude-3-haiku-20240307
#   - Nếu chọn LLM_PROVIDER=openrouter ➔ Mặc định dùng: google/gemini-2.5-flash
#
# ✏️ Ví dụ nếu muốn ĐỔI MODEL KHÁC (Điền tên Model cụ thể vào sau dấu =):
# LLM_MODEL=gpt-4o
# LLM_MODEL=claude-3-5-sonnet-20240620
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct
# -----------------------------------------------------------------------------
LLM_MODEL=

# =============================================================================
# 📷 CẤU HÌNH SERVICE OCR (Máy khác trong cùng mạng LAN, cổng 8080)
# =============================================================================

# 👉 ĐỔI "localhost" thành ĐỊA CHỈ IP của máy đang chạy service OCR.
#    Cách xem IP máy đó: mở CMD trên máy chạy OCR gõ `ipconfig` (Windows)
#    hoặc `ip addr` / `ifconfig` (Linux/macOS), lấy dòng IPv4 dạng 192.168.x.x
# Ví dụ: OCR_BASE_URL=http://192.168.1.15:8080
OCR_BASE_URL=http://localhost:8080

# Đường dẫn endpoint OCR.
#   - ĐỂ TRỐNG  ➔ client TỰ DÒ lần lượt: /ocr, /predict, /v1/ocr, /api/ocr, /
#   - Điền cụ thể ➔ chỉ gọi đúng endpoint đó (nhanh hơn, nên điền khi đã biết)
# Ví dụ: OCR_ENDPOINT=/api/v1/invoice
OCR_ENDPOINT=

# Tên field chứa file ảnh khi POST multipart/form-data.
# Client thử OCR_FIELD_NAME trước, không được thì fallback sang "image", "img", "upload".
OCR_FIELD_NAME=file

# Thời gian chờ tối đa mỗi lần gọi OCR (giây)
OCR_TIMEOUT=15

# =============================================================================
# 💰 CẤU HÌNH API CHUYỂN KHOẢN GIẢ LẬP (src/bank_api.py)
# =============================================================================

# Tỉ lệ giao dịch bị lỗi ngẫu nhiên (timeout) để demo Agent xử lý lỗi.
#   0.0 = không bao giờ lỗi (dùng khi cần demo mượt)
#   0.1 = 10% giao dịch bị timeout (mặc định)
BANK_FAIL_RATE=0.1

# Số dư tài khoản công ty giả lập (VNĐ). Vượt quá ➔ INSUFFICIENT_FUNDS.
BANK_COMPANY_BALANCE=500000000

# Seed ngẫu nhiên cố định ➔ kịch bản lỗi TÁI LẬP ĐƯỢC khi demo trước lớp.
BANK_RANDOM_SEED=42
